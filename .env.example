# Generate a unique value with at least 32 characters. Never commit the real .env file.
LEDGERFLOW_JWT_SECRET=replace-with-a-long-random-development-secret-at-least-32-bytes

# Optional first-start admin provisioning; leave both empty to disable.
# Use a valid email and a unique password of 12+ characters, at most 72 UTF-8 bytes.
# Remove these credentials after successful provisioning. Existing users are never promoted
# or re-enabled, and an existing enabled admin's password is never reset.
LEDGERFLOW_BOOTSTRAP_ADMIN_EMAIL=
LEDGERFLOW_BOOTSTRAP_ADMIN_PASSWORD=
